// PROPOSED rules, rebuilt from the hand-off notes: the live rules only exist in the Firebase console and were not readable.
// Compare with the console (Firestore > Rules) BEFORE publishing. This file is not wired into firebase.json on purpose.
// Behaviour: signed-in players read the ranking; each player writes only their own shop (name 1-10 chars, scores never go down)
// and their own push token. The Cloud Function (admin) bypasses these rules and writes tokens.lastPush.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /shops/{uid} {
      function ok() {
        let d = request.resource.data;
        return d.keys().hasOnly(['shopName','sold','earned','updatedAt'])
          && d.shopName is string && d.shopName.size() >= 1 && d.shopName.size() <= 10
          && d.sold is int && d.sold >= 0 && d.earned is int && d.earned >= 0;
      }
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid && ok();
      allow update: if request.auth.uid == uid && ok()
        && request.resource.data.sold >= resource.data.sold && request.resource.data.earned >= resource.data.earned;
      allow delete: if request.auth.uid == uid;
    }
    match /tokens/{uid} {
      // lastPush stays allowed in the field list: the client PATCH uses updateMask, so the merged document still carries it
      allow read, delete: if request.auth.uid == uid;
      allow create, update: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token','lang','lastPush'])
        && request.resource.data.token is string && request.resource.data.lang is string
        && (resource == null || request.resource.data.get('lastPush', null) == resource.data.get('lastPush', null));
    }
  }
}
