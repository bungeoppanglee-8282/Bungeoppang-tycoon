{
  "name": "bungeoppang-tycoon-app",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor shell for 붕어빵 타이쿤 (web game lives in ../game2)",
  "scripts": {
    "sync-web": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.cpSync('../web','www',{recursive:true,filter:s=>!s.endsWith('BRIEF.md')})\"",
    "sync": "npm run sync-web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "assets": "capacitor-assets generate --iconBackgroundColor '#C43E12' --splashBackgroundColor '#F28C34'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
